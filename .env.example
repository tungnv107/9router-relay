# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router

# ch-relay provider: optional policy file, reloaded before requests and during streams.
# Omit to use enforce + opt-in exact response cache + identical tool-schema deduplication.
# CH_RELAY_POLICY_FILE=D:/Projects/9RouterRelay/ch-relay.policy.example.json
# Emergency: block stops new/in-flight ch-relay requests; bypass disables optimization.
# CH_RELAY_POLICY_KILL=block

# Docker deployment (docker-compose.yml sets the relay URL/origin to its private service).
ROUTER_BIND_IP=127.0.0.1
ROUTER_PORT=20128
CH_RELAY_ADMIN_PORT=11504
NPM_NETWORK=npm_proxy
# For a separate trusted backend, allow exact origins; no wildcards or paths.
# CH_RELAY_BASE_URL=http://ch-relay:11500/v1
# CH_RELAY_ALLOWED_ORIGINS=http://ch-relay:11500

# Required when using the corresponding Google OAuth provider: supply a valid client ID/secret pair at runtime.
# Upstream embedded credentials and its historical commits are excluded from this fork.
# Antigravity and Gemini CLI use separate clients; do not interchange their credentials.
# After changing Docker env_file, recreate the router container to load the new values.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# For a web client, use the exact Authorized redirect URI saved in Google Cloud.
# Omit for the existing desktop/loopback login flow.
# ANTIGRAVITY_OAUTH_REDIRECT_URI=https://your-router.example/api/auth/callback/google
# GOOGLE_OAUTH_REDIRECT_URI=https://your-router.example/api/auth/callback/google
